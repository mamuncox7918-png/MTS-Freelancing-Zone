rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdminAuth() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedAdminAuth() &&
        request.auth.token.email is string &&
        request.auth.token.email.size() <= 150 &&
        request.auth.token.email.lower() == 'mamuncox7918@gmail.com';
    }

    function isAdmin() {
      return isVerifiedAdminAuth() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAssistantAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/assistantAdmins/$(request.auth.uid));
    }

    function isApprovedMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // Enforces that an Assistant Admin official task approval atomically credits the wallet/ledger
    // AND deletes the approved submission document in the exact same writeBatch.
    function isAtomicAssistantOfficialApproval(subId, memberUid) {
      return isValidId(subId) &&
        exists(/databases/$(database)/documents/submissions/$(subId)) &&
        get(/databases/$(database)/documents/submissions/$(subId)).data.userId == memberUid &&
        get(/databases/$(database)/documents/submissions/$(subId)).data.status == 'pending' &&
        !exists(/databases/$(database)/documents/transactions/$('tx_reward_' + subId)) &&
        !existsAfter(/databases/$(database)/documents/submissions/$(subId)) &&
        existsAfter(/databases/$(database)/documents/transactions/$('tx_reward_' + subId)) &&
        getAfter(/databases/$(database)/documents/transactions/$('tx_reward_' + subId)).data.userId == memberUid &&
        getAfter(/databases/$(database)/documents/transactions/$('tx_reward_' + subId)).data.type == 'task_reward' &&
        getAfter(/databases/$(database)/documents/transactions/$('tx_reward_' + subId)).data.amount == get(/databases/$(database)/documents/submissions/$(subId)).data.rewardAmount;
    }

    // =========================================================================
    // Validation Blueprints (Synchronized with firebase-blueprint.json)
    // =========================================================================
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.createdAt is timestamp;
    }

    function isValidAssistantAdminRecord(data) {
      return data.keys().hasAll(['uid', 'memberId', 'fullName', 'email', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'memberId', 'fullName', 'email', 'createdBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 300 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'memberId', 'fullName', 'email', 'authProvider',
          'role', 'status', 'completedTasksCount', 'pendingSubmissionsCount',
          'totalEarnings', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'memberId', 'fullName', 'email', 'phone', 'authProvider',
          'photoAssetId', 'role', 'status', 'rejectionReason',
          'completedTasksCount', 'pendingSubmissionsCount', 'totalEarnings',
          'lastPasswordChangedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 300 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
        data.authProvider is string && data.authProvider.size() <= 20 && data.authProvider in ['password', 'google.com'] &&
        (!('photoAssetId' in data) || (
          data.photoAssetId is string &&
          data.photoAssetId.size() <= 128 &&
          (data.photoAssetId == '' || isValidId(data.photoAssetId))
        )) &&
        data.role is string && data.role.size() <= 20 && data.role in ['member', 'assistant_admin', 'admin'] &&
        data.status is string && data.status.size() <= 15 && data.status in ['pending', 'approved', 'rejected'] &&
        (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 1000)) &&
        data.completedTasksCount is number && data.completedTasksCount >= 0 &&
        data.pendingSubmissionsCount is number && data.pendingSubmissionsCount >= 0 &&
        data.totalEarnings is number && data.totalEarnings >= 0 &&
        (!('lastPasswordChangedAt' in data) || (data.lastPasswordChangedAt is string && data.lastPasswordChangedAt.size() <= 40)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['assetId', 'ownerId', 'purpose', 'mimeType', 'dataUrl', 'sizeBytes', 'createdAt']) &&
        data.keys().hasOnly(['assetId', 'ownerId', 'purpose', 'mimeType', 'dataUrl', 'sizeBytes', 'createdAt']) &&
        isValidId(data.assetId) &&
        isValidId(data.ownerId) &&
        data.purpose is string && data.purpose.size() <= 10 && data.purpose in ['avatar', 'proof'] &&
        data.mimeType is string && data.mimeType.size() <= 20 && data.mimeType in ['image/webp', 'image/jpeg', 'image/png'] &&
        data.dataUrl is string && data.dataUrl.size() >= 20 && data.dataUrl.size() <= 250000 &&
        data.sizeBytes is number && data.sizeBytes > 0 && data.sizeBytes <= 200000 &&
        data.createdAt is timestamp;
    }

    function isValidTaskItem(data) {
      return data.keys().hasAll([
          'taskId', 'taskCode', 'title', 'instructions', 'externalLink',
          'rewardAmount', 'isActive', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'taskId', 'taskCode', 'title', 'instructions', 'externalLink',
          'rewardAmount', 'isActive', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.taskId) &&
        data.taskCode is string && data.taskCode.size() >= 6 && data.taskCode.size() <= 20 && data.taskCode.matches('^TSK-[0-9]{5}$') &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 400 &&
        data.instructions is string && data.instructions.size() >= 5 && data.instructions.size() <= 5000 &&
        data.externalLink is string && data.externalLink.size() >= 8 && data.externalLink.size() <= 500 &&
        data.rewardAmount is number && data.rewardAmount >= 1 && data.rewardAmount <= 100000 &&
        data.isActive is bool &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTaskSubmission(data) {
      return data.keys().hasAll([
          'submissionId', 'taskId', 'taskCode', 'taskTitle', 'rewardAmount',
          'userId', 'memberId', 'memberName', 'screenshotAssetId',
          'status', 'rejectionReason', 'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'submissionId', 'taskId', 'taskCode', 'taskTitle', 'rewardAmount',
          'userId', 'memberId', 'memberName', 'screenshotAssetId', 'proofLink', 'submissionNote',
          'status', 'rejectionReason', 'reviewedBy', 'reviewerId', 'reviewerName',
          'reviewerRole', 'reviewAction', 'reviewedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.submissionId) &&
        isValidId(data.taskId) &&
        data.taskCode is string && data.taskCode.size() >= 6 && data.taskCode.size() <= 20 &&
        data.taskTitle is string && data.taskTitle.size() >= 2 && data.taskTitle.size() <= 400 &&
        data.rewardAmount is number && data.rewardAmount >= 1 && data.rewardAmount <= 100000 &&
        isValidId(data.userId) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 300 &&
        isValidId(data.screenshotAssetId) &&
        (!('proofLink' in data) || (
          data.proofLink is string &&
          data.proofLink.size() <= 500 &&
          (data.proofLink == '' || data.proofLink.matches('^[hH][tT][tT][pP][sS]?://.+'))
        )) &&
        (!('submissionNote' in data) || (data.submissionNote is string && data.submissionNote.size() <= 1500)) &&
        data.status is string && data.status.size() <= 15 && data.status in ['pending', 'approved', 'rejected'] &&
        data.rejectionReason is string && data.rejectionReason.size() <= 1000 &&
        data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
        (!('reviewerId' in data) || (data.reviewerId is string && data.reviewerId.size() <= 30)) &&
        (!('reviewerName' in data) || (data.reviewerName is string && data.reviewerName.size() <= 300)) &&
        (!('reviewerRole' in data) || (data.reviewerRole is string && data.reviewerRole.size() <= 20 && data.reviewerRole in ['', 'admin', 'assistant_admin'])) &&
        (!('reviewAction' in data) || (data.reviewAction is string && data.reviewAction.size() <= 15 && data.reviewAction in ['', 'approved', 'rejected'])) &&
        data.reviewedAt is string && data.reviewedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomTaskSubmission(data) {
      return data.keys().hasAll([
          'customTaskId', 'customTaskCode', 'userId', 'memberId', 'memberName',
          'taskName', 'taskDetails', 'requestedAmount', 'approvedAmount', 'screenshotAssetId',
          'status', 'assistantStatus', 'assistantNote', 'assistantReviewedBy',
          'assistantReviewerId', 'assistantReviewerName', 'assistantReviewedAt',
          'rejectionReason', 'reviewedBy', 'reviewerId', 'reviewerName', 'reviewedAt',
          'transactionId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'customTaskId', 'customTaskCode', 'userId', 'memberId', 'memberName',
          'taskName', 'taskDetails', 'requestedAmount', 'approvedAmount', 'screenshotAssetId',
          'status', 'assistantStatus', 'assistantNote', 'assistantReviewedBy',
          'assistantReviewerId', 'assistantReviewerName', 'assistantReviewedAt',
          'rejectionReason', 'reviewedBy', 'reviewerId', 'reviewerName', 'reviewedAt',
          'transactionId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.customTaskId) &&
        data.customTaskCode is string && data.customTaskCode.size() >= 6 && data.customTaskCode.size() <= 20 && data.customTaskCode.matches('^CTK-[0-9]{5}$') &&
        isValidId(data.userId) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 300 &&
        data.taskName is string && data.taskName.size() >= 2 && data.taskName.size() <= 400 &&
        data.taskDetails is string && data.taskDetails.size() >= 5 && data.taskDetails.size() <= 5000 &&
        data.requestedAmount is number && data.requestedAmount >= 1 && data.requestedAmount <= 100000 &&
        data.approvedAmount is number && data.approvedAmount >= 0 && data.approvedAmount <= 100000 &&
        data.screenshotAssetId is string && data.screenshotAssetId.size() <= 128 &&
        (data.screenshotAssetId == '' || isValidId(data.screenshotAssetId)) &&
        data.status is string && data.status.size() <= 15 && data.status in ['pending', 'approved', 'rejected'] &&
        data.assistantStatus is string && data.assistantStatus.size() <= 25 && data.assistantStatus in ['unreviewed', 'reviewed', 'recommended_approve', 'recommended_reject'] &&
        data.assistantNote is string && data.assistantNote.size() <= 1000 &&
        data.assistantReviewedBy is string && data.assistantReviewedBy.size() <= 128 &&
        data.assistantReviewerId is string && data.assistantReviewerId.size() <= 30 &&
        data.assistantReviewerName is string && data.assistantReviewerName.size() <= 300 &&
        data.assistantReviewedAt is string && data.assistantReviewedAt.size() <= 40 &&
        data.rejectionReason is string && data.rejectionReason.size() <= 1000 &&
        data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
        data.reviewerId is string && data.reviewerId.size() <= 30 &&
        data.reviewerName is string && data.reviewerName.size() <= 300 &&
        data.reviewedAt is string && data.reviewedAt.size() <= 40 &&
        data.transactionId is string && data.transactionId.size() <= 128 &&
        (data.transactionId == '' || isValidId(data.transactionId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMemberNotification(data) {
      return data.keys().hasAll([
          'notificationId', 'userId', 'type', 'title', 'message', 'referenceId', 'isRead', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'notificationId', 'userId', 'type', 'title', 'message', 'referenceId', 'isRead', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.notificationId) &&
        isValidId(data.userId) &&
        data.type is string && data.type.size() <= 30 && data.type in [
          'custom_task_approved', 'custom_task_rejected', 'task_approved', 'task_rejected',
          'earning_reversed', 'leaderboard_reward'
        ] &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 200 &&
        data.message is string && data.message.size() >= 3 && data.message.size() <= 1000 &&
        isValidId(data.referenceId) &&
        data.isRead is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMemberWallet(data) {
      return data.keys().hasAll([
          'userId', 'memberId', 'availableBalance', 'totalEarnings',
          'totalWithdrawals', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'memberId', 'availableBalance', 'totalEarnings',
          'totalWithdrawals', 'totalWithdrawalFees', 'reservedWithdrawals',
          'lastWithdrawalId', 'lastCreditedSubmissionId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.availableBalance is number && data.availableBalance >= 0 &&
        data.totalEarnings is number && data.totalEarnings >= 0 &&
        data.totalWithdrawals is number && data.totalWithdrawals >= 0 &&
        (!('totalWithdrawalFees' in data) || (data.totalWithdrawalFees is number && data.totalWithdrawalFees >= 0)) &&
        (!('reservedWithdrawals' in data) || (data.reservedWithdrawals is number && data.reservedWithdrawals >= 0)) &&
        (!('lastWithdrawalId' in data) || (
          data.lastWithdrawalId is string &&
          data.lastWithdrawalId.size() <= 128 &&
          (data.lastWithdrawalId == '' || isValidId(data.lastWithdrawalId))
        )) &&
        (!('lastCreditedSubmissionId' in data) || (
          data.lastCreditedSubmissionId is string &&
          data.lastCreditedSubmissionId.size() <= 128 &&
          (data.lastCreditedSubmissionId == '' || isValidId(data.lastCreditedSubmissionId))
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWalletTransaction(data) {
      return data.keys().hasAll([
          'transactionId', 'userId', 'memberId', 'type', 'amount',
          'feeAmount', 'netAmount', 'direction', 'description', 'referenceId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'transactionId', 'userId', 'memberId', 'type', 'amount',
          'feeAmount', 'netAmount', 'direction', 'description', 'referenceId',
          'taskId', 'taskCode', 'taskName', 'submissionId', 'approvedAt', 'createdAt'
        ]) &&
        isValidId(data.transactionId) &&
        isValidId(data.userId) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.type is string && data.type.size() <= 30 && data.type in [
          'task_reward', 'custom_task_reward', 'earning_reversal',
          'withdrawal_request', 'withdrawal_paid', 'withdrawal_refund'
        ] &&
        data.amount is number && data.amount > 0 &&
        data.feeAmount is number && data.feeAmount >= 0 &&
        data.netAmount is number && data.netAmount > 0 &&
        data.direction is string && data.direction.size() <= 15 && data.direction in ['credit', 'debit', 'settlement'] &&
        data.description is string && data.description.size() >= 3 && data.description.size() <= 1000 &&
        isValidId(data.referenceId) &&
        (!('taskId' in data) || (
          data.taskId is string &&
          data.taskId.size() <= 128 &&
          (data.taskId == '' || isValidId(data.taskId))
        )) &&
        (!('taskCode' in data) || (data.taskCode is string && data.taskCode.size() <= 20)) &&
        (!('taskName' in data) || (data.taskName is string && data.taskName.size() <= 400)) &&
        (!('submissionId' in data) || (
          data.submissionId is string &&
          data.submissionId.size() <= 128 &&
          (data.submissionId == '' || isValidId(data.submissionId))
        )) &&
        (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 40)) &&
        data.createdAt is timestamp;
    }

    function isValidWithdrawalRequest(data) {
      return data.keys().hasAll([
          'withdrawalId', 'transactionCode', 'userId', 'memberId', 'memberName',
          'payoutMethod', 'accountNumber', 'grossAmount', 'feeAmount', 'netAmount',
          'status', 'adminNote', 'paymentReference', 'processedBy', 'processedAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'withdrawalId', 'transactionCode', 'userId', 'memberId', 'memberName',
          'payoutMethod', 'accountNumber', 'grossAmount', 'feeAmount', 'netAmount',
          'status', 'adminNote', 'paymentReference', 'processedBy', 'processedAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.withdrawalId) &&
        data.transactionCode is string && data.transactionCode.size() >= 8 && data.transactionCode.size() <= 25 && data.transactionCode.matches('^WDR-[0-9A-Z\\-]+$') &&
        isValidId(data.userId) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 300 &&
        data.payoutMethod is string && data.payoutMethod.size() <= 15 && data.payoutMethod in ['bKash', 'Nagad'] &&
        data.accountNumber is string && data.accountNumber.size() >= 11 && data.accountNumber.size() <= 15 && data.accountNumber.matches('^(\\+88)?01[3-9][0-9]{8}$') &&
        data.grossAmount is number && data.grossAmount >= 100 && data.grossAmount <= 500000 &&
        data.feeAmount is number && data.feeAmount == 5 &&
        data.netAmount is number && data.netAmount >= 95 && data.netAmount == data.grossAmount - 5 &&
        data.status is string && data.status.size() <= 15 && data.status in ['pending', 'paid', 'rejected'] &&
        data.adminNote is string && data.adminNote.size() <= 1000 &&
        data.paymentReference is string && data.paymentReference.size() <= 100 &&
        data.processedBy is string && data.processedBy.size() <= 128 &&
        data.processedAt is string && data.processedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPasswordChangeRequest(data) {
      return data.keys().hasAll([
          'requestId', 'userId', 'memberId', 'memberName', 'memberEmail',
          'authProvider', 'reason', 'status', 'decisionNote', 'reviewedBy',
          'reviewedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'requestId', 'userId', 'memberId', 'memberName', 'memberEmail',
          'authProvider', 'reason', 'status', 'decisionNote', 'reviewedBy',
          'reviewedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.requestId) &&
        isValidId(data.userId) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 300 &&
        data.memberEmail is string && data.memberEmail.size() >= 3 && data.memberEmail.size() <= 150 &&
        data.authProvider is string && data.authProvider.size() <= 20 && data.authProvider in ['password', 'google.com'] &&
        data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 1200 &&
        data.status is string && data.status.size() <= 15 && data.status in ['pending', 'approved', 'rejected', 'completed'] &&
        data.decisionNote is string && data.decisionNote.size() <= 1000 &&
        data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
        data.reviewedAt is string && data.reviewedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll([
          'logId', 'adminUid', 'adminEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'logId', 'adminUid', 'adminEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt'
        ]) &&
        isValidId(data.logId) &&
        isValidId(data.adminUid) &&
        data.adminEmail is string && data.adminEmail.size() >= 3 && data.adminEmail.size() <= 150 &&
        data.action is string && data.action.size() >= 3 && data.action.size() <= 80 &&
        data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 40 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 1500 &&
        data.createdAt is timestamp;
    }

    function isValidMonthKeyString(mk) {
      return mk is string && mk.size() == 7 && mk.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function isValidMonthlyMemberEarning(data) {
      return data.keys().hasAll([
          'entryId', 'monthKey', 'userId', 'displayName', 'photoAssetId',
          'isEligibleMember', 'eligibleEarnings', 'approvedTaskCount',
          'reachedAtMs', 'lastTransactionId', 'lastSubmissionId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'entryId', 'monthKey', 'userId', 'displayName', 'photoAssetId',
          'isEligibleMember', 'eligibleEarnings', 'approvedTaskCount',
          'reachedAtMs', 'lastTransactionId', 'lastSubmissionId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.entryId) &&
        isValidMonthKeyString(data.monthKey) &&
        isValidId(data.userId) &&
        data.entryId == data.monthKey + '_' + data.userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 300 &&
        data.photoAssetId is string && data.photoAssetId.size() <= 128 &&
        (data.photoAssetId == '' || isValidId(data.photoAssetId)) &&
        data.isEligibleMember is bool &&
        data.eligibleEarnings is number && data.eligibleEarnings >= 0 && data.eligibleEarnings <= 100000000 &&
        data.approvedTaskCount is number && data.approvedTaskCount >= 0 && data.approvedTaskCount <= 1000000 &&
        data.reachedAtMs is number && data.reachedAtMs >= 0 &&
        isValidId(data.lastTransactionId) &&
        data.lastSubmissionId is string && data.lastSubmissionId.size() <= 128 &&
        (data.lastSubmissionId == '' || isValidId(data.lastSubmissionId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRewardSlot(slot, expectedRank) {
      return slot is map &&
        slot.keys().hasAll(['rank', 'prizeTitle', 'prizeDescription', 'monetaryValue', 'enabled']) &&
        slot.keys().hasOnly(['rank', 'prizeTitle', 'prizeDescription', 'monetaryValue', 'enabled']) &&
        slot.rank is number && slot.rank == expectedRank &&
        slot.prizeTitle is string && slot.prizeTitle.size() <= 160 &&
        slot.prizeDescription is string && slot.prizeDescription.size() <= 500 &&
        slot.monetaryValue is number && slot.monetaryValue >= 0 && slot.monetaryValue <= 10000000 &&
        slot.enabled is bool;
    }

    function isValidLeaderboardPeriod(data) {
      return data.keys().hasAll([
          'monthKey', 'status', 'rewardsPublished', 'announcementDate', 'rewardNote',
          'rewards', 'finalizedAt', 'finalizedBy', 'winnerCount', 'lastSyncedAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'monthKey', 'status', 'rewardsPublished', 'announcementDate', 'rewardNote',
          'rewards', 'finalizedAt', 'finalizedBy', 'winnerCount', 'lastSyncedAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidMonthKeyString(data.monthKey) &&
        data.status is string && data.status.size() <= 15 && data.status in ['open', 'finalized'] &&
        data.rewardsPublished is bool &&
        data.announcementDate is string && data.announcementDate.size() <= 40 &&
        data.rewardNote is string && data.rewardNote.size() <= 1000 &&
        data.rewards is list && data.rewards.size() == 10 &&
        isValidRewardSlot(data.rewards[0], 1) &&
        isValidRewardSlot(data.rewards[1], 2) &&
        isValidRewardSlot(data.rewards[2], 3) &&
        isValidRewardSlot(data.rewards[3], 4) &&
        isValidRewardSlot(data.rewards[4], 5) &&
        isValidRewardSlot(data.rewards[5], 6) &&
        isValidRewardSlot(data.rewards[6], 7) &&
        isValidRewardSlot(data.rewards[7], 8) &&
        isValidRewardSlot(data.rewards[8], 9) &&
        isValidRewardSlot(data.rewards[9], 10) &&
        data.finalizedAt is string && data.finalizedAt.size() <= 40 &&
        data.finalizedBy is string && data.finalizedBy.size() <= 128 &&
        (data.finalizedBy == '' || isValidId(data.finalizedBy)) &&
        data.winnerCount is number && data.winnerCount >= 0 && data.winnerCount <= 10 &&
        data.lastSyncedAt is string && data.lastSyncedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLeaderboardWinner(data) {
      return data.keys().hasAll([
          'winnerId', 'monthKey', 'rank', 'userId', 'displayName', 'photoAssetId',
          'eligibleEarnings', 'approvedTaskCount', 'reachedAtMs', 'prizeTitle',
          'prizeDescription', 'monetaryValue', 'rewardStatus', 'deliveredAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'winnerId', 'monthKey', 'rank', 'userId', 'displayName', 'photoAssetId',
          'eligibleEarnings', 'approvedTaskCount', 'reachedAtMs', 'prizeTitle',
          'prizeDescription', 'monetaryValue', 'rewardStatus', 'deliveredAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.winnerId) &&
        data.winnerId.size() == 10 &&
        data.winnerId.matches('^[0-9]{4}-(0[1-9]|1[0-2])_(0[1-9]|10)$') &&
        isValidMonthKeyString(data.monthKey) &&
        data.rank is number && data.rank >= 1 && data.rank <= 10 &&
        isValidId(data.userId) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 300 &&
        data.photoAssetId is string && data.photoAssetId.size() <= 128 &&
        (data.photoAssetId == '' || isValidId(data.photoAssetId)) &&
        data.eligibleEarnings is number && data.eligibleEarnings > 0 && data.eligibleEarnings <= 100000000 &&
        data.approvedTaskCount is number && data.approvedTaskCount >= 1 && data.approvedTaskCount <= 1000000 &&
        data.reachedAtMs is number && data.reachedAtMs >= 0 &&
        data.prizeTitle is string && data.prizeTitle.size() <= 160 &&
        data.prizeDescription is string && data.prizeDescription.size() <= 500 &&
        data.monetaryValue is number && data.monetaryValue >= 0 && data.monetaryValue <= 10000000 &&
        data.rewardStatus is string && data.rewardStatus.size() <= 15 &&
        data.rewardStatus in ['pending', 'approved', 'awarded', 'cancelled'] &&
        data.deliveredAt is string && data.deliveredAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLeaderboardAdminNote(data) {
      return data.keys().hasAll([
          'winnerId', 'monthKey', 'rank', 'userId', 'memberId',
          'adminNote', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'winnerId', 'monthKey', 'rank', 'userId', 'memberId',
          'adminNote', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.winnerId) &&
        data.winnerId.size() == 10 &&
        isValidMonthKeyString(data.monthKey) &&
        data.rank is number && data.rank >= 1 && data.rank <= 10 &&
        isValidId(data.userId) &&
        data.memberId is string && data.memberId.size() >= 6 && data.memberId.size() <= 20 &&
        data.adminNote is string && data.adminNote.size() <= 1000 &&
        isValidId(data.updatedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Match Blocks (All 17 Collections)
    // =========================================================================

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create: if isVerifiedAdminAuth() && isValidId(adminId) && isValidAdminRecord(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /assistantAdmins/{assistantId} {
      allow get: if isSignedIn() && isValidId(assistantId) && (request.auth.uid == assistantId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedAdminAuth() && isValidId(assistantId) && isValidAssistantAdminRecord(incoming()) &&
        incoming().uid == assistantId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if isVerifiedAdminAuth() && isValidId(assistantId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        isAdmin() ||
        isAssistantAdmin()
      );
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (
            request.auth.uid == userId &&
            incoming().role == 'member' &&
            incoming().status == 'pending' &&
            incoming().completedTasksCount == 0 &&
            incoming().pendingSubmissionsCount == 0 &&
            incoming().totalEarnings == 0
          ) || (
            request.auth.uid == userId &&
            isAdmin() &&
            incoming().role == 'admin' &&
            incoming().status == 'approved' &&
            incoming().completedTasksCount == 0 &&
            incoming().pendingSubmissionsCount == 0 &&
            incoming().totalEarnings == 0
          ) || (
            isAdmin() &&
            incoming().role == 'assistant_admin' &&
            incoming().status == 'approved' &&
            incoming().completedTasksCount == 0 &&
            incoming().pendingSubmissionsCount == 0 &&
            incoming().totalEarnings == 0 &&
            existsAfter(/databases/$(database)/documents/assistantAdmins/$(userId))
          )
        );
      allow update: if isSignedIn() && isValidUserProfile(incoming()) && isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().memberId == existing().memberId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Main Admin manages member/assistant status, role, rejection reason, or summary counters
          (
            isAdmin() &&
            (
              incoming().role == existing().role ||
              (existing().role != 'admin' && incoming().role in ['member', 'assistant_admin'])
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role', 'status', 'rejectionReason', 'completedTasksCount',
              'pendingSubmissionsCount', 'totalEarnings', 'photoAssetId',
              'lastPasswordChangedAt', 'updatedAt'
            ])
          ) ||
          // Action 1B: Assistant Admin updates member task counters ONLY during atomic official submission review
          (
            isAssistantAdmin() &&
            existing().role == 'member' &&
            incoming().role == 'member' &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'completedTasksCount', 'pendingSubmissionsCount', 'totalEarnings', 'updatedAt'
            ]) && (
              (
                incoming().totalEarnings == existing().totalEarnings &&
                incoming().completedTasksCount == existing().completedTasksCount &&
                incoming().pendingSubmissionsCount == (existing().pendingSubmissionsCount > 0 ? existing().pendingSubmissionsCount - 1 : 0)
              ) || (
                incoming().completedTasksCount == existing().completedTasksCount + 1 &&
                incoming().pendingSubmissionsCount == (existing().pendingSubmissionsCount > 0 ? existing().pendingSubmissionsCount - 1 : 0) &&
                existsAfter(/databases/$(database)/documents/wallets/$(userId)) &&
                ('lastCreditedSubmissionId' in getAfter(/databases/$(database)/documents/wallets/$(userId)).data) &&
                isAtomicAssistantOfficialApproval(
                  getAfter(/databases/$(database)/documents/wallets/$(userId)).data.lastCreditedSubmissionId,
                  userId
                ) &&
                incoming().totalEarnings == existing().totalEarnings + get(/databases/$(database)/documents/submissions/$(getAfter(/databases/$(database)/documents/wallets/$(userId)).data.lastCreditedSubmissionId)).data.rewardAmount
              )
            )
          ) ||
          // Action 2: Bootstrapped owner elevates own initial profile to admin
          (
            isBootstrappedAdmin() &&
            request.auth.uid == userId &&
            incoming().role == 'admin' &&
            incoming().status == 'approved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'updatedAt'])
          ) ||
          // Action 3: Owner updates personal profile details
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'photoAssetId', 'updatedAt'])
          ) ||
          // Action 4: Owner records timestamp of approved password change completion
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastPasswordChangedAt', 'updatedAt'])
          ) ||
          // Action 5: Approved owner increments pending submission counter
          (
            request.auth.uid == userId &&
            existing().status == 'approved' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().pendingSubmissionsCount == existing().pendingSubmissionsCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['pendingSubmissionsCount', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /mediaAssets/{assetId} {
      allow get: if isSignedIn() && isValidId(assetId) && (
        resource.data.purpose == 'avatar' ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        isAssistantAdmin()
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(assetId) && isValidMediaAsset(incoming()) &&
        incoming().assetId == assetId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(assetId) && (
        isAdmin() ||
        (resource != null && resource.data.ownerId == request.auth.uid && resource.data.purpose == 'avatar') ||
        (
          isAssistantAdmin() && (
            resource == null || (
              resource.data.purpose == 'proof' &&
              existsAfter(/databases/$(database)/documents/wallets/$(resource.data.ownerId)) &&
              ('lastCreditedSubmissionId' in getAfter(/databases/$(database)/documents/wallets/$(resource.data.ownerId)).data) &&
              isAtomicAssistantOfficialApproval(
                getAfter(/databases/$(database)/documents/wallets/$(resource.data.ownerId)).data.lastCreditedSubmissionId,
                resource.data.ownerId
              ) &&
              get(/databases/$(database)/documents/submissions/$(getAfter(/databases/$(database)/documents/wallets/$(resource.data.ownerId)).data.lastCreditedSubmissionId)).data.screenshotAssetId == assetId
            )
          )
        )
      );
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && (
        (resource.data.isActive == true && isApprovedMember()) ||
        isAdmin() ||
        isAssistantAdmin()
      );
      allow list: if isBootstrappedAdmin() || isAssistantAdmin() || (isSignedIn() && resource.data.isActive == true);
      allow create: if isVerifiedAdminAuth() && isValidId(taskId) && isValidTaskItem(incoming()) &&
        incoming().taskId == taskId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedAdminAuth() && isValidTaskItem(incoming()) && isValidId(taskId) &&
        incoming().taskId == existing().taskId &&
        incoming().taskCode == existing().taskCode &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'instructions', 'externalLink', 'rewardAmount', 'isActive', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && isValidId(submissionId) && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isAssistantAdmin()
      );
      allow list: if isBootstrappedAdmin() || isAssistantAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(submissionId) && isValidTaskSubmission(incoming()) &&
        incoming().submissionId == submissionId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().rejectionReason == '' &&
        incoming().reviewedBy == '' &&
        incoming().reviewedAt == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isApprovedMember() &&
        exists(/databases/$(database)/documents/tasks/$(incoming().taskId)) &&
        get(/databases/$(database)/documents/tasks/$(incoming().taskId)).data.isActive == true &&
        get(/databases/$(database)/documents/tasks/$(incoming().taskId)).data.rewardAmount == incoming().rewardAmount &&
        exists(/databases/$(database)/documents/mediaAssets/$(incoming().screenshotAssetId)) &&
        get(/databases/$(database)/documents/mediaAssets/$(incoming().screenshotAssetId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidTaskSubmission(incoming()) && isValidId(submissionId) &&
        incoming().submissionId == existing().submissionId &&
        incoming().taskId == existing().taskId &&
        incoming().userId == existing().userId &&
        incoming().rewardAmount == existing().rewardAmount &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status == 'pending' &&
        incoming().status == 'rejected' &&
        incoming().rejectionReason.size() >= 3 &&
        incoming().reviewedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'rejectionReason', 'reviewedBy', 'reviewerId', 'reviewerName',
          'reviewerRole', 'reviewAction', 'reviewedAt', 'updatedAt'
        ]) &&
        (isAdmin() || isAssistantAdmin());
      allow delete: if isSignedIn() && isValidId(submissionId) && (
        isAdmin() ||
        (
          isAssistantAdmin() &&
          resource != null &&
          isAtomicAssistantOfficialApproval(submissionId, resource.data.userId)
        )
      );
    }

    match /customTasks/{customTaskId} {
      allow get: if isSignedIn() && isValidId(customTaskId) && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isAssistantAdmin()
      );
      allow list: if isBootstrappedAdmin() || isAssistantAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(customTaskId) && isValidCustomTaskSubmission(incoming()) &&
        incoming().customTaskId == customTaskId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().approvedAmount == 0 &&
        incoming().assistantStatus == 'unreviewed' &&
        incoming().assistantNote == '' &&
        incoming().assistantReviewedBy == '' &&
        incoming().assistantReviewerId == '' &&
        incoming().assistantReviewerName == '' &&
        incoming().assistantReviewedAt == '' &&
        incoming().rejectionReason == '' &&
        incoming().reviewedBy == '' &&
        incoming().reviewerId == '' &&
        incoming().reviewerName == '' &&
        incoming().reviewedAt == '' &&
        incoming().transactionId == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isApprovedMember() &&
        (
          incoming().screenshotAssetId == '' || (
            exists(/databases/$(database)/documents/mediaAssets/$(incoming().screenshotAssetId)) &&
            get(/databases/$(database)/documents/mediaAssets/$(incoming().screenshotAssetId)).data.ownerId == request.auth.uid
          )
        );
      allow update: if isSignedIn() && isValidCustomTaskSubmission(incoming()) && isValidId(customTaskId) &&
        incoming().customTaskId == existing().customTaskId &&
        incoming().customTaskCode == existing().customTaskCode &&
        incoming().userId == existing().userId &&
        incoming().memberId == existing().memberId &&
        incoming().memberName == existing().memberName &&
        incoming().taskName == existing().taskName &&
        incoming().taskDetails == existing().taskDetails &&
        incoming().requestedAmount == existing().requestedAmount &&
        incoming().screenshotAssetId == existing().screenshotAssetId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Assistant Admin (or Main Admin) inspects custom task & records recommendation without crediting wallet
          (
            (isAssistantAdmin() || isAdmin()) &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().approvedAmount == 0 &&
            incoming().assistantStatus in ['reviewed', 'recommended_approve', 'recommended_reject'] &&
            (incoming().assistantStatus != 'recommended_reject' || incoming().assistantNote.size() >= 3) &&
            incoming().assistantReviewedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'assistantStatus', 'assistantNote', 'assistantReviewedBy',
              'assistantReviewerId', 'assistantReviewerName', 'assistantReviewedAt', 'updatedAt'
            ])
          ) ||
          // Action 2: ONLY Main Admin rejects custom task (approvals atomically credit wallet & delete customTask)
          (
            isAdmin() &&
            existing().status == 'pending' &&
            incoming().reviewedBy == request.auth.uid &&
            incoming().status == 'rejected' &&
            incoming().approvedAmount == 0 &&
            incoming().rejectionReason.size() >= 3 &&
            incoming().transactionId == '' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'approvedAmount', 'rejectionReason', 'reviewedBy',
              'reviewerId', 'reviewerName', 'reviewedAt', 'transactionId', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedAdminAuth() && isValidId(customTaskId) && isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(notificationId) && isValidMemberNotification(incoming()) &&
        incoming().notificationId == notificationId &&
        incoming().isRead == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || isAssistantAdmin());
      allow update: if isSignedIn() && isValidMemberNotification(incoming()) && isValidId(notificationId) &&
        request.auth.uid == existing().userId &&
        incoming().notificationId == existing().notificationId &&
        incoming().userId == existing().userId &&
        incoming().type == existing().type &&
        incoming().title == existing().title &&
        incoming().message == existing().message &&
        incoming().referenceId == existing().referenceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().isRead == false &&
        incoming().isRead == true &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']);
      allow delete: if false;
    }

    match /wallets/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        isAdmin() ||
        isAssistantAdmin()
      );
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(userId) && isValidMemberWallet(incoming()) &&
        incoming().userId == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isAssistantAdmin() &&
            ('lastCreditedSubmissionId' in incoming()) &&
            incoming().totalWithdrawals == 0 &&
            isAtomicAssistantOfficialApproval(incoming().lastCreditedSubmissionId, userId) &&
            incoming().availableBalance == get(/databases/$(database)/documents/submissions/$(incoming().lastCreditedSubmissionId)).data.rewardAmount &&
            incoming().totalEarnings == get(/databases/$(database)/documents/submissions/$(incoming().lastCreditedSubmissionId)).data.rewardAmount
          ) ||
          (
            request.auth.uid == userId &&
            incoming().availableBalance == 0 &&
            incoming().totalEarnings == 0 &&
            incoming().totalWithdrawals == 0 &&
            (!('totalWithdrawalFees' in incoming()) || incoming().totalWithdrawalFees == 0) &&
            (!('reservedWithdrawals' in incoming()) || incoming().reservedWithdrawals == 0) &&
            (!('lastWithdrawalId' in incoming()) || incoming().lastWithdrawalId == '')
          )
        );
      allow update: if isSignedIn() && isValidMemberWallet(incoming()) && isValidId(userId) &&
        incoming().userId == existing().userId &&
        incoming().memberId == existing().memberId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Main Admin settlement (official reward, custom task payment, withdrawal paid/refund)
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'availableBalance', 'totalEarnings', 'totalWithdrawals',
              'totalWithdrawalFees', 'reservedWithdrawals', 'lastWithdrawalId',
              'lastCreditedSubmissionId', 'updatedAt'
            ])
          ) ||
          // Action 2: Assistant Admin atomic single-credit on official task approval ONLY (zero manual balance changes)
          (
            isAssistantAdmin() &&
            ('lastCreditedSubmissionId' in incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'availableBalance', 'totalEarnings', 'lastCreditedSubmissionId', 'updatedAt'
            ]) &&
            isAtomicAssistantOfficialApproval(incoming().lastCreditedSubmissionId, userId) &&
            incoming().availableBalance == existing().availableBalance + get(/databases/$(database)/documents/submissions/$(incoming().lastCreditedSubmissionId)).data.rewardAmount &&
            incoming().totalEarnings == existing().totalEarnings + get(/databases/$(database)/documents/submissions/$(incoming().lastCreditedSubmissionId)).data.rewardAmount
          ) ||
          // Action 3: Atomic member withdrawal reservation verified via getAfter
          (
            request.auth.uid == userId &&
            isApprovedMember() &&
            ('lastWithdrawalId' in incoming()) &&
            isValidId(incoming().lastWithdrawalId) &&
            ('reservedWithdrawals' in incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'availableBalance', 'reservedWithdrawals', 'lastWithdrawalId', 'updatedAt'
            ]) &&
            incoming().availableBalance < existing().availableBalance &&
            (existing().availableBalance - incoming().availableBalance) >= 100 &&
            incoming().reservedWithdrawals == (('reservedWithdrawals' in existing()) ? existing().reservedWithdrawals : 0) + (existing().availableBalance - incoming().availableBalance) &&
            !exists(/databases/$(database)/documents/withdrawals/$(incoming().lastWithdrawalId)) &&
            getAfter(/databases/$(database)/documents/withdrawals/$(incoming().lastWithdrawalId)).data.userId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/withdrawals/$(incoming().lastWithdrawalId)).data.grossAmount == (existing().availableBalance - incoming().availableBalance)
          )
        );
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(transactionId) && isValidWalletTransaction(incoming()) &&
        incoming().transactionId == transactionId &&
        incoming().createdAt == request.time && (
          isAdmin() ||
          (
            isAssistantAdmin() &&
            incoming().type == 'task_reward' &&
            incoming().direction == 'credit' &&
            incoming().feeAmount == 0 &&
            incoming().netAmount == incoming().amount &&
            transactionId == 'tx_reward_' + incoming().referenceId &&
            isAtomicAssistantOfficialApproval(incoming().referenceId, incoming().userId) &&
            existsAfter(/databases/$(database)/documents/wallets/$(incoming().userId)) &&
            getAfter(/databases/$(database)/documents/wallets/$(incoming().userId)).data.lastCreditedSubmissionId == incoming().referenceId
          ) ||
          (
            incoming().userId == request.auth.uid &&
            incoming().type == 'withdrawal_request' &&
            incoming().direction == 'debit' &&
            incoming().amount >= 100 &&
            incoming().feeAmount == 5 &&
            incoming().netAmount == incoming().amount - 5 &&
            !exists(/databases/$(database)/documents/withdrawals/$(incoming().referenceId)) &&
            getAfter(/databases/$(database)/documents/withdrawals/$(incoming().referenceId)).data.userId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/withdrawals/$(incoming().referenceId)).data.grossAmount == incoming().amount
          )
        );
      allow update: if false;
      allow delete: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && isValidId(withdrawalId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(withdrawalId) && isValidWithdrawalRequest(incoming()) &&
        incoming().withdrawalId == withdrawalId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().adminNote == '' &&
        incoming().paymentReference == '' &&
        incoming().processedBy == '' &&
        incoming().processedAt == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isApprovedMember() &&
        get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.availableBalance >= incoming().grossAmount &&
        getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.availableBalance == get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.availableBalance - incoming().grossAmount;
      allow update: if isVerifiedAdminAuth() && isValidWithdrawalRequest(incoming()) && isValidId(withdrawalId) &&
        incoming().withdrawalId == existing().withdrawalId &&
        incoming().userId == existing().userId &&
        incoming().grossAmount == existing().grossAmount &&
        incoming().feeAmount == existing().feeAmount &&
        incoming().netAmount == existing().netAmount &&
        incoming().payoutMethod == existing().payoutMethod &&
        incoming().accountNumber == existing().accountNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status == 'pending' &&
        (incoming().status == 'paid' || incoming().status == 'rejected') &&
        incoming().processedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'adminNote', 'paymentReference', 'processedBy', 'processedAt', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    match /passwordChangeRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(requestId) && isValidPasswordChangeRequest(incoming()) &&
        incoming().requestId == requestId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().decisionNote == '' &&
        incoming().reviewedBy == '' &&
        incoming().reviewedAt == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isApprovedMember();
      allow update: if isSignedIn() && isValidPasswordChangeRequest(incoming()) && isValidId(requestId) &&
        incoming().requestId == existing().requestId &&
        incoming().userId == existing().userId &&
        incoming().reason == existing().reason &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Main Admin approves or rejects a pending request
          (
            isAdmin() &&
            existing().status == 'pending' &&
            (incoming().status == 'approved' || incoming().status == 'rejected') &&
            incoming().reviewedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'decisionNote', 'reviewedBy', 'reviewedAt', 'updatedAt'
            ])
          ) ||
          // Action 2: Requesting member marks approved request completed after updating auth password
          (
            request.auth.uid == existing().userId &&
            existing().status == 'approved' &&
            incoming().status == 'completed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow get: if isVerifiedAdminAuth() && isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAdminAuditLog(incoming()) &&
        incoming().logId == logId &&
        incoming().adminUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        (isAdmin() || isAssistantAdmin());
      allow update: if false;
      allow delete: if false;
    }

    match /monthlyMemberEarnings/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(entryId) && isValidMonthlyMemberEarning(incoming()) &&
        incoming().entryId == entryId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isAssistantAdmin() &&
            incoming().isEligibleMember == true &&
            isValidId(incoming().lastSubmissionId) &&
            incoming().lastTransactionId == 'tx_reward_' + incoming().lastSubmissionId &&
            incoming().approvedTaskCount == 1 &&
            isAtomicAssistantOfficialApproval(incoming().lastSubmissionId, incoming().userId) &&
            incoming().eligibleEarnings == get(/databases/$(database)/documents/submissions/$(incoming().lastSubmissionId)).data.rewardAmount
          )
        );
      allow update: if isSignedIn() && isValidId(entryId) && isValidMonthlyMemberEarning(incoming()) &&
        incoming().entryId == existing().entryId &&
        incoming().monthKey == existing().monthKey &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isAssistantAdmin() &&
            existing().isEligibleMember == true &&
            incoming().isEligibleMember == true &&
            isValidId(incoming().lastSubmissionId) &&
            incoming().lastTransactionId == 'tx_reward_' + incoming().lastSubmissionId &&
            incoming().approvedTaskCount == existing().approvedTaskCount + 1 &&
            incoming().reachedAtMs >= existing().reachedAtMs &&
            isAtomicAssistantOfficialApproval(incoming().lastSubmissionId, existing().userId) &&
            incoming().eligibleEarnings == existing().eligibleEarnings + get(/databases/$(database)/documents/submissions/$(incoming().lastSubmissionId)).data.rewardAmount
          ) ||
          (
            request.auth.uid == existing().userId &&
            incoming().isEligibleMember == existing().isEligibleMember &&
            incoming().eligibleEarnings == existing().eligibleEarnings &&
            incoming().approvedTaskCount == existing().approvedTaskCount &&
            incoming().reachedAtMs == existing().reachedAtMs &&
            incoming().lastTransactionId == existing().lastTransactionId &&
            incoming().lastSubmissionId == existing().lastSubmissionId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoAssetId', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /leaderboardPeriods/{monthKey} {
      allow get: if isSignedIn() && isValidId(monthKey);
      allow list: if isSignedIn();
      allow create: if isVerifiedAdminAuth() && isValidId(monthKey) && isValidLeaderboardPeriod(incoming()) &&
        incoming().monthKey == monthKey &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedAdminAuth() && isValidId(monthKey) && isValidLeaderboardPeriod(incoming()) &&
        incoming().monthKey == existing().monthKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if false;
    }

    match /leaderboardWinners/{winnerId} {
      allow get: if isSignedIn() && isValidId(winnerId);
      allow list: if isSignedIn();
      allow create: if isVerifiedAdminAuth() && isValidId(winnerId) && isValidLeaderboardWinner(incoming()) &&
        incoming().winnerId == winnerId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedAdminAuth() && isValidId(winnerId) && isValidLeaderboardWinner(incoming()) &&
        incoming().winnerId == existing().winnerId &&
        incoming().monthKey == existing().monthKey &&
        incoming().rank == existing().rank &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if isVerifiedAdminAuth() && isValidId(winnerId) && isAdmin();
    }

    match /leaderboardAdminNotes/{winnerId} {
      allow get: if isVerifiedAdminAuth() && isValidId(winnerId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedAdminAuth() && isValidId(winnerId) && isValidLeaderboardAdminNote(incoming()) &&
        incoming().winnerId == winnerId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedAdminAuth() && isValidId(winnerId) && isValidLeaderboardAdminNote(incoming()) &&
        incoming().winnerId == existing().winnerId &&
        incoming().monthKey == existing().monthKey &&
        incoming().rank == existing().rank &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if isVerifiedAdminAuth() && isValidId(winnerId) && isAdmin();
    }
  }
}
